# 复制本文件为 `.env` 后再填写。
# 这是最小配置入口。完整覆盖项见 `.env.full.example` 和 `docs/config.md`。
#
# 默认保持安全模式：
# - `WALLET_PRIVATE_KEY` 留空；
# - 资金上限保持 `0`；
# - `/ready` 不会进入 `ready_to_trade=true`。
#
# 自动交易至少需要同时满足：
# - `WALLET_PRIVATE_KEY` 非空；
# - `PORTFOLIO_BUDGET_USDC` 大于 `0`（bankroll 软上限）；
# - Kelly 参数 `KELLY_FRACTION`、`KELLY_MAX_POSITION_FRACTION`、`KELLY_MIN_STAKE_USDC` 在合法范围；
# - 数据库、Market WS、User WS、reconcile 健康。
#
# 需要改接口地址、队列/超时、拆分数据库字段或 API 凭证时，再看 `.env.full.example`。

# 数据库
# 优先使用完整连接串；留空时会回退到 `Settings` 里的拆分字段默认值。
DATABASE_URL=

# 策略装配
# 策略代码在 `src/polymarket_trader/quant/`；策略规则优先改 strategy_config.toml，不要往 `.env` 塞业务参数。
STRATEGY_CONFIG_PATH=

# Bankroll 软上限（USDC）。实际 bankroll = min(链上 USDC, PORTFOLIO_BUDGET_USDC)。
# 默认 0 → ready_to_trade=false，不会下单。
PORTFOLIO_BUDGET_USDC=0

# Kelly sizing（默认 quarter Kelly + 10% 单市场上限 + 200 bps 最小 edge + $1 floor）
KELLY_FRACTION=0.25
KELLY_MAX_POSITION_FRACTION=0.10
KELLY_MIN_EDGE=0.02
KELLY_MIN_STAKE_USDC=1
KELLY_ALLOW_ROUND_UP_TO_MARKET_MIN=true
KELLY_ROUND_UP_MAX_OVERBET_RATIO=1.0
KELLY_DRAWDOWN_HALT_FRACTION=0.5

# 钱包与签名
WALLET_PRIVATE_KEY=
# 普通 EOA 保持 `0`；只有 proxy / safe 才改，并同时填写 `POLYMARKET_FUNDER_ADDRESS`。
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER_ADDRESS=
