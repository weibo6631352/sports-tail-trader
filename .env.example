# 复制本文件为 `.env` 后再填写。
# 这是最小配置入口。完整覆盖项见 `.env.full.example` 和 `docs/config.md`。
#
# 默认保持安全模式：
# - `WALLET_PRIVATE_KEY` 留空；
# - 资金上限保持 `0`；
# - `/ready` 不会进入 `ready_to_trade=true`。
#
# 自动交易至少需要同时满足：
# - `WALLET_PRIVATE_KEY` 非空；
# - `PORTFOLIO_BUDGET_USDC`、`MAX_ORDER_USDC`、`MAX_MARKET_USDC`、`MAX_TOTAL_USDC`、`MAX_OPEN_ORDERS` 都大于 `0`；
# - 数据库、Market WS、User WS、reconcile 健康。
#
# 需要改接口地址、队列/超时、拆分数据库字段或 API 凭证时，再看 `.env.full.example`。

# 数据库
# 优先使用完整连接串；留空时会回退到 `Settings` 里的拆分字段默认值。
DATABASE_URL=

# 策略装配
# 默认策略是 `src/strategies/current/`；策略规则优先改策略包，不要往 `.env` 塞业务参数。
EXTENSION_MODULE=strategies.current
EXTENSION_CONFIG_PATH=

# 自动交易资金闸门
PORTFOLIO_BUDGET_USDC=0
MAX_ORDER_USDC=0
MAX_MARKET_USDC=0
MAX_TOTAL_USDC=0
MAX_OPEN_ORDERS=0

# 钱包与签名
WALLET_PRIVATE_KEY=
# 普通 EOA 保持 `0`；只有 proxy / safe 才改，并同时填写 `POLYMARKET_FUNDER_ADDRESS`。
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER_ADDRESS=
