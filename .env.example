# 复制本文件为 `.env` 后填写。最小化的运行参数；其它框架开关见 `.env.full.example`。
#
# 默认安全模式（不改 .env 即开机就锁住）：
# - `WALLET_PRIVATE_KEY` 留空 → 无法签名 → 必然不下单
# - `PORTFOLIO_BUDGET_USDC=0` → bankroll=0 → ready_to_trade=false
# - 体现在 `/ready` 端点。
#
# 自动交易至少需要：
# - `WALLET_PRIVATE_KEY` 非空
# - `PORTFOLIO_BUDGET_USDC` > 0（bankroll 软上限）
# - 数据库、Market WS、User WS、reconcile 健康
#
# **策略参数（Kelly / 阈值 / 信号权重）不在 .env，全部走 `strategy_config.toml`**——
# 改 `.env.KELLY_FRACTION` 会被静默忽略。Kelly 实现细节见 strategy_config.toml 注释。

# 数据库
# 优先使用完整连接串；留空时回退到 Settings 里的拆分字段默认值（host=localhost, port=5432, db=trader）。
DATABASE_URL=

# 策略装配（指向 strategy_config.toml 路径，留空走默认）
WORKFLOW_CONFIG_PATH=

# Bankroll 软上限（USDC）。实际 bankroll = min(链上 USDC, PORTFOLIO_BUDGET_USDC)。
# 默认 0 → ready_to_trade=false，不会下单。
PORTFOLIO_BUDGET_USDC=0

# 钱包与签名
WALLET_PRIVATE_KEY=
# 普通 EOA 保持 `0`；proxy / safe 才改，并同时填写 `POLYMARKET_FUNDER_ADDRESS`。
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER_ADDRESS=
