# 全部 Settings 字段（除已废弃外）。字段名必须和 Settings 类一致，否则 pydantic 会报错。
# 仅在需要覆盖默认值时取消注释。`Settings` 已不存在的字段不在本文件出现。
#
# **策略参数（Kelly / 阈值 / 信号权重）走 `strategy_config.toml`，不在本文件。**
# 本文件只放框架级配置（DB / Polymarket 接入 / 队列容量 / 队列超时 / Goalserve 数据源等）。

# === Polymarket 接入 ===
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_DATA_HOST=https://data-api.polymarket.com
POLYMARKET_MARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=0
# 只有 POLYMARKET_SIGNATURE_TYPE=1 或 2 时才需要填。
POLYMARKET_FUNDER_ADDRESS=

# === 策略装配 ===
# 指向 strategy_config.toml 路径，留空走默认。
WORKFLOW_CONFIG_PATH=

# === Bankroll & 同步周期 ===
PORTFOLIO_BUDGET_USDC=0
# 0 = 真实账户（实盘），true = paper trading 模式（虚拟撮合）
PAPER_TRADING_MODE=false
MARKET_SYNC_INTERVAL_SECONDS=20

# === 体育直播状态源（Goalserve）===
# 体育直播状态总开关 + 联赛白名单
SPORTS_LIVE_STATE_ENABLED=true
SPORTS_LIVE_STATE_LEAGUES=nba,nhl,nfl,mlb,tennis,sports,atp,wta,itf,bkbbl,bkseriea
SPORTS_LIVE_STATE_INTERVAL_SECONDS=3
# Goalserve 出口代理（仅开发环境本机 Clash 用，生产留空直连）
GOALSERVE_PROXY=
# Goalserve API key（livescore + pregame 都需要）
GOALSERVE_API_KEY=
# Goalserve livescore（覆盖 inplay feed 没有的运动：cricket/handball/rugby/...）
GOALSERVE_LIVESCORE_ENABLED=true
GOALSERVE_LIVESCORE_BASE_URL=http://www.goalserve.com/getfeed
GOALSERVE_LIVESCORE_TIMEOUT_S=10.0
# Goalserve 赛前赔率（数据量大 >100MB，默认关闭）
GOALSERVE_PREGAME_ENABLED=false
GOALSERVE_PREGAME_SPORTS=soccer,basketball,tennis,hockey,baseball,amfootball,esports,mma,cricket,rugby,volleyball,handball,boxing,darts,table_tennis,futsal,rugbyleague
GOALSERVE_PREGAME_BASE_URL=http://www.goalserve.com
GOALSERVE_PREGAME_TIMEOUT_S=30.0
GOALSERVE_PREGAME_INTERVAL_SECONDS=300

# === 赛季 + 单场赔率（the-odds-api，独立于 Goalserve）===
SPORTS_SEASON_ODDS_PROVIDER=theoddsapi
SPORTS_SEASON_ODDS_API_KEY=
SPORTS_SEASON_ODDS_BASE_URL=https://api.the-odds-api.com
SPORTS_SEASON_ODDS_REGIONS=us,eu
SPORTS_SEASON_ODDS_INTERVAL_SECONDS=1800
SPORTS_SEASON_ODDS_TTL_SECONDS=1800
SPORTS_GAME_ODDS_PROVIDER=theoddsapi
SPORTS_GAME_ODDS_API_KEY=
SPORTS_GAME_ODDS_BASE_URL=https://api.the-odds-api.com
SPORTS_GAME_ODDS_REGIONS=us,eu
SPORTS_GAME_ODDS_INTERVAL_SECONDS=1800
SPORTS_GAME_ODDS_TTL_SECONDS=1800

# === 性能 / 队列 / 超时 ===
TRADING_EVENT_QUEUE_MAX_SIZE=1000
MAINTENANCE_EVENT_QUEUE_MAX_SIZE=1000
PERSISTENCE_EVENT_QUEUE_MAX_SIZE=5000
TRADING_WORKER_THREADS=4
MAINTENANCE_WORKER_THREADS=4
MAINTENANCE_PROCESS_WORKERS=2
ORDER_SUBMIT_TIMEOUT_MS=3000
ORDER_SIGN_TIMEOUT_MS=1000
CRITICAL_LOCK_TIMEOUT_MS=20
TRADING_QUEUE_WARN_DEPTH=100
ENTRY_SIGNAL_TO_SUBMIT_WARN_MS=500
SSE_SUBSCRIBER_CAP=32

# === API 服务暴露面 ===
# 生产应关掉 Swagger 文档（admin endpoint 是高危写入入口）
EXPOSE_OPENAPI_DOCS=true
# 配置后非豁免路径必须带 X-Admin-Token 头；为空时 admin 接口裸跑（仅本机/受信网络）
ADMIN_API_TOKEN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174

# === 数据库 ===
# 优先用完整 DATABASE_URL；为空时回退到下面拆分字段拼接。
DATABASE_URL=
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trader
DATABASE_USER=trader
DATABASE_PASSWORD=

# === 审计 / 持久化 retention ===
# audit_events 分层 retention（天）：0 关闭，-1 永久（fills 内部硬编码永久）
AUDIT_RETENTION_DAYS=3
AUDIT_RETENTION_INTERVAL_SECONDS=3600
AUDIT_RETENTION_PURGE_BATCH_SIZE=10000
DEAD_RECORDS_RETENTION_DAYS=2
DEAD_RECORDS_RETENTION_INTERVAL_SECONDS=3600
FILLS_RETENTION_DAYS=14
OUTBOX_RETENTION_DAYS=1
DECISION_RECORDS_RETENTION_DAYS=7
ACCOUNT_SNAPSHOTS_RETENTION_DAYS=14

# === 敏感密钥 ===
# 三件套要么都填，要么全空（运行时派生）
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
WALLET_PRIVATE_KEY=
SIGNER_PRIVATE_KEY=
