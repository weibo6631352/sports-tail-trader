# 完整覆盖项示例。
# 常用启动入口看 `.env.example`；这里列出 `Settings` 已声明的全部环境变量。
# 字段名必须和本文件一致；未声明字段会直接报错。

# Polymarket 地址与签名
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_DATA_HOST=https://data-api.polymarket.com
POLYMARKET_MARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=0
# 只有 `POLYMARKET_SIGNATURE_TYPE=1` 或 `2` 时才需要填写。
POLYMARKET_FUNDER_ADDRESS=

# 策略装配
EXTENSION_MODULE=strategies.current
EXTENSION_CONFIG_PATH=

# 预算与框架风控阈值
PORTFOLIO_BUDGET_USDC=0
MAX_ORDER_USDC=0
MAX_MARKET_USDC=0
MAX_TOTAL_USDC=0
MARKET_SYNC_INTERVAL_SECONDS=60
ORDER_RETRY_LIMIT=2
MAX_OPEN_ORDERS=0

# 体育直播状态源
# 只用于运行时比分/阶段事实输入，不承载策略阈值。
SPORTS_LIVE_STATE_ENABLED=false
SPORTS_LIVE_STATE_SOURCES=espn,nba,nhl,mlb,sofascore,thesportsdb
SPORTS_LIVE_STATE_ESPN_BASE_URL=https://site.api.espn.com
SPORTS_LIVE_STATE_NBA_BASE_URL=https://cdn.nba.com
SPORTS_LIVE_STATE_NHL_BASE_URL=https://api-web.nhle.com
SPORTS_LIVE_STATE_MLB_BASE_URL=https://statsapi.mlb.com
SPORTS_LIVE_STATE_SOFASCORE_BASE_URL=https://www.sofascore.com
SPORTS_LIVE_STATE_SOFASCORE_LOOKAHEAD_DAYS=1
SPORTS_LIVE_STATE_THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json/3
SPORTS_LIVE_STATE_LEAGUES=nba,nhl,nfl,mlb,tennis,sports
SPORTS_LIVE_STATE_INTERVAL_SECONDS=5
SPORTS_LIVE_STATE_TIMEOUT_S=5.0
SPORTS_LIVE_STATE_PUBLISH_ENTRY_SIGNALS=true

# 性能隔离、队列与超时
ENABLE_UVLOOP=true
TRADING_EVENT_QUEUE_MAX_SIZE=1000
MAINTENANCE_EVENT_QUEUE_MAX_SIZE=1000
PERSISTENCE_EVENT_QUEUE_MAX_SIZE=5000
TRADING_WORKER_THREADS=4
MAINTENANCE_WORKER_THREADS=4
MAINTENANCE_PROCESS_WORKERS=2
ORDER_SUBMIT_TIMEOUT_MS=3000
ORDER_SIGN_TIMEOUT_MS=1000
CRITICAL_LOCK_TIMEOUT_MS=20
TRADING_QUEUE_WARN_DEPTH=100
ENTRY_SIGNAL_TO_SUBMIT_WARN_MS=500

# 数据库
# 优先使用 `DATABASE_URL`；为空时再使用下面的拆分字段拼接连接串。
DATABASE_URL=
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trader
DATABASE_USER=trader
DATABASE_PASSWORD=

# 敏感密钥
# `POLYMARKET_API_KEY` / `POLYMARKET_API_SECRET` / `POLYMARKET_API_PASSPHRASE`
# 要么同时提供，要么全部留空并在运行时派生。
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
WALLET_PRIVATE_KEY=
SIGNER_PRIVATE_KEY=
# 当前只参与配置脱敏输出；没有接入时保持空值。
BUILDER_ATTRIBUTION_CREDENTIALS=
